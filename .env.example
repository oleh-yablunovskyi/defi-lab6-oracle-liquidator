# Settings of the scripts and of the liquidator bot. Copy this file to .env and fill it in;
# git ignores .env. Another file can be used with ENV_FILE, for example ENV_FILE=.env.fork
# for the rehearsal on a local fork of Sepolia.

# Name and symbol of the stablecoin, read by scripts/deploy.ts
STABLECOIN_NAME=StudentUSD
STABLECOIN_SYMBOL=sUSD

# Sepolia JSON-RPC endpoint of Hardhat (--network sepolia and the sepoliaFork network)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the wallet that deploys the contracts and opens the debt position on Sepolia.
# Only --network sepolia needs it. Never commit or share it.
DEPLOYER_PRIVATE_KEY=

# The liquidator bot, bot/liquidator.ts
# Private key of the bot wallet: `npm run new-bot-wallet` creates a wallet and saves its key here
BOT_PRIVATE_KEY=
# JSON-RPC endpoint the bot reads the chain through and sends its transactions to
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The StableEngine and the debtor to watch (several debtors: addresses separated by commas);
# scripts/open-position.ts prints both
ENGINE_ADDRESS=
DEBTOR_ADDRESS=
# Seconds between two checks
POLL_INTERVAL_SECONDS=12
